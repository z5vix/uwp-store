+/*
+ * XSystemGetAnalyticsInfo's class. Its first method returns an XSystemAnalyticsInfo by value: the caller passes the
+ * hidden result pointer after the object and copies 0x90 bytes from the pointer returned in rax. The stub object's
+ * FALSE there was a NULL that Minecraft for Windows (1.26) read at start-up.
+ */
+typedef struct
+{
+    UINT16 major, minor, build, revision;
+} xversion;
+
+typedef struct
+{
+    xversion os_version;
+    xversion hosting_os_version;
+    char family[64];
+    char form[64];
+} xsystem_analytics_info;
+
+static xsystem_analytics_info * WINAPI analytics_GetAnalyticsInfo( gdk_object *iface, xsystem_analytics_info *info )
+{
+    OSVERSIONINFOW os = { sizeof(os) };
+
+    memset( info, 0, sizeof(*info) );
+    GetVersionExW( &os );
+    info->os_version.major = os.dwMajorVersion;
+    info->os_version.minor = os.dwMinorVersion;
+    info->os_version.build = os.dwBuildNumber;
+    info->hosting_os_version = info->os_version;
+    strcpy( info->family, "Windows.Desktop" );
+    strcpy( info->form, "Desktop" );
+    TRACE( "%u.%u.%u %s %s\n", info->os_version.major, info->os_version.minor, info->os_version.build,
+           info->family, info->form );
+    return info;
+}
+
+static const void *const analytics_vtbl[] =
+{
+    stub_QueryInterface, stub_AddRef, stub_Release,
+    analytics_GetAnalyticsInfo,
+    stub_hresult, stub_hresult, stub_hresult, stub_hresult,
+};
+
