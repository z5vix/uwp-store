 DEFINE_IINSPECTABLE( device_statics, IDeviceInformationStatics, struct device_information_statics, IActivationFactory_iface );
 
+/* the device container that stands for this PC; it always exists on Windows */
+static const WCHAR local_machine_container[] = L"{00000000-0000-0000-FFFF-FFFFFFFFFFFF}";
+
+static HRESULT create_from_id_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct devquery_params *params;
+    const DEVPROPERTY *props = NULL;
+    IDeviceInformation *info;
+    DEV_OBJECT obj = {0};
+    ULONG len = 0;
+    HRESULT hr;
+
+    TRACE( "invoker %p, param %p, result %p, called_async %d\n", invoker, param, result, called_async );
+
+    if (!called_async) return STATUS_PENDING;
+
+    params = impl_from_IUnknown( param );
+    hr = DevGetObjectProperties( params->type, params->id, DevQueryFlagNone, params->prop_keys_len, params->prop_keys,
+                                 &len, &props );
+    if (FAILED(hr))
+    {
+        if (wcsicmp( params->id, local_machine_container )) return hr;
+        /* Minecraft for Windows asks for this PC's container at start-up and throws when it is missing */
+        WARN( "no properties for the local machine container (%#lx); returning it without them\n", hr );
+        props = NULL;
+        len = 0;
+    }
+    obj.ObjectType = params->type;
+    obj.pszObjectId = params->id;
+    obj.cPropertyCount = len;
+    obj.pProperties = props;
+    hr = device_information_create( &obj, &info );
+    if (props) DevFreeObjectProperties( len, props );
+    if (FAILED(hr)) return hr;
+
+    result->vt = VT_UNKNOWN;
+    result->punkVal = (IUnknown *)info;
+    return S_OK;
+}
+
+static HRESULT create_from_id( IUnknown *invoker, HSTRING id, IIterable_HSTRING *additional_properties,
+                               DeviceInformationKind kind, IAsyncOperation_DeviceInformation **op )
+{
+    static const DEV_OBJECT_TYPE kind_type[] = {
+        DevObjectTypeDeviceInterfaceDisplay, /* Unknown: an interface id, as IDeviceInformationStatics takes */
+        DevObjectTypeDeviceInterfaceDisplay,
+        DevObjectTypeDeviceContainerDisplay,
+        DevObjectTypeDevice,
+        DevObjectTypeDeviceInterfaceClass,
+        DevObjectTypeAEP,
+        DevObjectTypeAEPContainer,
+        DevObjectTypeAEPService,
+        DevObjectTypeDevicePanel,
+    };
+    const DEVPROPCOMPKEY device_iface_default_props[] = {
+        { DEVPKEY_DeviceInterface_Enabled, DEVPROP_STORE_SYSTEM, NULL },
+        { DEVPKEY_Device_InstanceId, DEVPROP_STORE_SYSTEM, NULL },
+    };
+    struct devquery_params *impl;
+    DEVPROPCOMPKEY *prop_keys = NULL;
+    ULONG prop_keys_len = 0;
+    const WCHAR *raw;
+    IUnknown *params;
+    UINT32 raw_len;
+    HRESULT hr;
+
+    if (!op) return E_POINTER;
+    *op = NULL;
+    raw = WindowsGetStringRawBuffer( id, &raw_len );
+    if (!raw_len) return E_INVALIDARG;
+    if (kind >= ARRAY_SIZE( kind_type )) return E_INVALIDARG;
+
+    if (kind <= DeviceInformationKind_DeviceInterface &&
+        FAILED(hr = devpropcompkeys_init( &prop_keys, &prop_keys_len, device_iface_default_props,
+                                          ARRAY_SIZE( device_iface_default_props ) ))) return hr;
+    if (additional_properties && FAILED(hr = devpropcompkeys_append_names( &prop_keys, &prop_keys_len, additional_properties )))
+    {
+        free( prop_keys );
+        return hr;
+    }
+    if (FAILED(hr = devquery_params_create( kind_type[kind], NULL, prop_keys, prop_keys_len, &params )))
+    {
+        free( prop_keys );
+        return hr;
+    }
+    impl = impl_from_IUnknown( params );
+    if (!(impl->id = malloc( (raw_len + 1) * sizeof(WCHAR) )))
+    {
+        IUnknown_Release( params );
+        return E_OUTOFMEMORY;
+    }
+    memcpy( impl->id, raw, raw_len * sizeof(WCHAR) );
+    impl->id[raw_len] = 0;
+
+    hr = async_operation_inspectable_create( &IID_IAsyncOperation_DeviceInformation, invoker, params, create_from_id_async,
+                                             (IAsyncOperation_IInspectable **)op );
+    IUnknown_Release( params );
+    return hr;
+}
