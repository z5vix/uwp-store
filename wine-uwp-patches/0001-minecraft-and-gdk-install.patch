+/* Titles whose MicrosoftGame.Config MSAAppId Windows only redeems through the system account broker (WAM): SISU
+ * answers 401 for it. The same game's mobile MSA client gets the title's Xbox Live tokens through SISU instead (the
+ * PlayFab title behind Minecraft is shared by every Bedrock platform), so the device-code sign-in and SISU use that
+ * client, and the title binding counts for the TitleId the game asked for. */
+static const struct { const char *config_app, *sisu_app; } sisu_aliases[] =
+{
+    { "0000000040159362", "0000000048183522" },  /* Minecraft for Windows (GDK) -> Minecraft (Android) */
+};
+
+const char *sisu_client_for( const char *msa_app )
+{
+    unsigned i;
+    for (i = 0; msa_app && i < ARRAY_SIZE(sisu_aliases); i++)
+        if (!_stricmp( msa_app, sisu_aliases[i].config_app )) return sisu_aliases[i].sisu_app;
+    return msa_app;
+}
