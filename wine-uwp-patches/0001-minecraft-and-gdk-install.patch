+/* Sign in with a refresh token for MSA_CLIENT_ID that another program obtained (the store's own Microsoft account
+ * sign-in uses this client): the last account is signed out as by sign_out (the device stays) and the token is saved
+ * like one from the device-code flow. The next token request redeems it. */
+HRESULT WINAPI XboxAuthImportRefreshToken( const char *refresh, const char *user_id )
+{
+    if (!refresh || !*refresh) return E_INVALIDARG;
+    sign_out();
+    EnterCriticalSection( &account.signin_cs );
+    EnterCriticalSection( &account.cs );
+    str_set( &account.refresh_token, refresh );
+    if (user_id && *user_id) str_set( &account.msa_user_id, user_id );
+    LeaveCriticalSection( &account.cs );
+    store_update( "refresh_token", refresh, "user_id", user_id ? user_id : "", NULL );
+    LeaveCriticalSection( &account.signin_cs );
+    TRACE( "refresh token imported\n" );
+    return S_OK;
+}
+
+/* Games whose MicrosoftGame.Config names their own MSAAppId (Minecraft's 0000000040159362) get their title identity
+ * from a refresh token for that client, which only a device-code sign-in for that client gives. Another program that
+ * ran that sign-in (the store) hands the token over here; it is kept like one from sign_in_with_device_code_client,
+ * with the user id of the account it belongs to, so a token left by an earlier account is not taken for this one. */
+static char *client_user_key( const char *client_id )
+{
+    return strf( "client_user_%s", client_id );
+}
+
+HRESULT WINAPI XboxAuthImportClientRefreshToken( const char *client_id, const char *refresh )
+{
+    char *key, *user_key, *user;
+
+    if (!client_id || !*client_id || !refresh || !*refresh) return E_INVALIDARG;
+    account_init();
+    client_id = sisu_client_for( client_id );
+    key = refresh_store_key( client_id );
+    if (!strcmp( key, "refresh_token" ))
+    {
+        free( key );
+        return E_INVALIDARG;            /* the Xbox app's client: XboxAuthImportRefreshToken */
+    }
+    user_key = client_user_key( client_id );
+    user = store_get( "user_id" );
+    store_update( key, refresh, user_key, user ? user : "", NULL );
+    TRACE( "refresh token for client %s imported\n", client_id );
+    free( user );
+    free( user_key );
+    free( key );
+    return S_OK;
+}
+
+/* S_OK when the signed-in account has a refresh token for this client, S_FALSE when it needs the device-code
+ * sign-in for it. */
+HRESULT WINAPI XboxAuthHasClient( const char *client_id )
+{
+    char *key, *user_key, *refresh, *owner, *user;
+    HRESULT hr;
+
+    if (!client_id || !*client_id) return E_INVALIDARG;
+    account_init();
+    client_id = sisu_client_for( client_id );
+    key = refresh_store_key( client_id );
+    user_key = client_user_key( client_id );
+    refresh = store_get( key );
+    owner = store_get( user_key );
+    user = store_get( "user_id" );
+    if (!refresh || !*refresh) hr = S_FALSE;
+    else if (!strcmp( key, "refresh_token" )) hr = S_OK;
+    else hr = (owner && user && !_stricmp( owner, user )) ? S_OK : S_FALSE;
+    TRACE( "client %s: refresh %s, owner %Iu chars, user %Iu chars, %s -> %#lx\n", client_id,
+           refresh && *refresh ? "yes" : "no", owner ? strlen( owner ) : 0, user ? strlen( user ) : 0,
+           owner && user && !_stricmp( owner, user ) ? "same account" : "other account", hr );
+    str_wipe_free( refresh );
+    free( owner );
+    free( user );
+    free( user_key );
+    free( key );
+    return hr;
+}
