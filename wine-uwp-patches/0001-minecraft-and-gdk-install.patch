+/****************************************************************************
+ *              LdrResolveDelayLoadsFromDll   (NTDLL.@)
+ *
+ * Bind every delay-loaded import that the module at base takes from target now (Minecraft for Windows calls
+ * kernelbase's ResolveDelayLoadsFromDll at start-up). Imports that cannot be bound stay lazy.
+ */
+NTSTATUS WINAPI LdrResolveDelayLoadsFromDll( void *base, const char *target, ULONG flags )
+{
+    const IMAGE_DELAYLOAD_DESCRIPTOR *desc;
+    IMAGE_THUNK_DATA *iat, *names;
+    NTSTATUS status = STATUS_DLL_NOT_FOUND;
+    ULONG size;
+
+    TRACE( "(%p, %s, 0x%08lx)\n", base, debugstr_a(target), flags );
+
+    if (!base || !target) return STATUS_INVALID_PARAMETER;
+    if (!(desc = RtlImageDirectoryEntryToData( base, TRUE, IMAGE_DIRECTORY_ENTRY_DELAY_IMPORT, &size )))
+        return STATUS_DLL_NOT_FOUND;
+
+    for (; desc->DllNameRVA; desc++)
+    {
+        if (_stricmp( get_rva( base, desc->DllNameRVA ), target )) continue;
+        status = STATUS_SUCCESS;
+        iat = get_rva( base, desc->ImportAddressTableRVA );
+        names = get_rva( base, desc->ImportNameTableRVA );
+        for (; names->u1.AddressOfData; iat++, names++)
+        {
+            if (!LdrResolveDelayLoadedAPI( base, desc, NULL, delayload_resolve_all_failed, iat, 0 ))
+                status = STATUS_PROCEDURE_NOT_FOUND;
+        }
+    }
+    return status;
+}
+
