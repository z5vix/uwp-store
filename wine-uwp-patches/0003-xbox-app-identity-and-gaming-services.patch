+/* ---- Which version of the API the app was built against ----
+ *
+ * IUser and IXboxAuthManager keep their (name-derived) IIDs while Gaming Services adds methods in the middle of
+ * them, so the vtable an app calls through depends on the Microsoft.GamePlatform.Services.winmd its projection was
+ * generated from. Each package ships that winmd at its root: the Microsoft Store's lacks User.LocalId and
+ * XboxAuthManager.RestartApps, the Xbox app's has both. With no winmd in the package the newer layout is used.
+ */
+static BOOL package_winmd_has( const char *name )
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    static char *winmd;
+    static DWORD winmd_size;
+    BOOL pending = FALSE;
+    DWORD i, len = strlen( name );
+
+    if (InitOnceBeginInitialize( &once, 0, &pending, NULL ) && pending)
+    {
+        WCHAR path[MAX_PATH];
+        DWORD n = GetEnvironmentVariableW( L"WINE_UWP_PACKAGE_PATH", path, MAX_PATH );
+        HANDLE file;
+
+        if (n && n < MAX_PATH - 48)
+        {
+            if (path[n - 1] != '\\') wcscat( path, L"\\" );
+            wcscat( path, L"Microsoft.GamePlatform.Services.winmd" );
+            file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+            if (file != INVALID_HANDLE_VALUE)
+            {
+                DWORD size = GetFileSize( file, NULL ), got = 0;
+                if (size != INVALID_FILE_SIZE && size < 64 << 20 && (winmd = malloc( size )) &&
+                    ReadFile( file, winmd, size, &got, NULL ) && got == size)
+                    winmd_size = size;
+                else
+                {
+                    free( winmd );
+                    winmd = NULL;
+                }
+                CloseHandle( file );
+            }
+        }
+        TRACE( "package winmd: %s\n", winmd ? "found" : "none, using the newer layouts" );
+        InitOnceComplete( &once, 0, NULL );
+    }
+    if (!winmd) return TRUE;
+    /* a name in the #Strings heap: NUL on both sides */
+    for (i = 1; i + len < winmd_size; i++)
+        if (!winmd[i - 1] && !winmd[i + len] && !memcmp( winmd + i, name, len )) return TRUE;
+    return FALSE;
+}
