+
+/*
+ * An app that installs a platform component itself (the Xbox app installs or updates Gaming Services from the
+ * gamingservices-signed.appxbundle it carries) gets that component's stand-in identity (standin.c) raised to the
+ * version it ships, and a deployment that succeeded: the component's client API is wine-uwp's own, so there is
+ * nothing else to install. Any other package still is not deployed from here.
+ */
+
+#include <ctype.h>
+#include <stdlib.h>
+#include <zlib.h>
+
+#include "private.h"
+#include "shlwapi.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(appx);
+
+#define STANDIN_KEY L"Software\\Wine\\WineUWP\\StandInPackages"
+
+/* ---- the manifest of a .appx / .appxbundle file (zip, maybe zip64) ---- */
+
+static BOOL read_at( HANDLE file, UINT64 offset, void *buf, DWORD size )
+{
+    LARGE_INTEGER pos;
+    DWORD got;
+
+    pos.QuadPart = offset;
+    return SetFilePointerEx( file, pos, NULL, FILE_BEGIN ) && ReadFile( file, buf, size, &got, NULL ) && got == size;
+}
+
+static UINT16 u16( const BYTE *p ) { return p[0] | p[1] << 8; }
+static UINT32 u32( const BYTE *p ) { return u16( p ) | (UINT32)u16( p + 2 ) << 16; }
+static UINT64 u64( const BYTE *p ) { return u32( p ) | (UINT64)u32( p + 4 ) << 32; }
+
+/* Wine's zlib has no default allocator */
+static void *zalloc( void *opaque, unsigned int items, unsigned int size ) { return calloc( items, size ); }
+static void zfree( void *opaque, void *ptr ) { free( ptr ); }
+
+/* the named member, inflated and NUL-terminated */
+static char *zip_member( HANDLE file, const char *wanted )
+{
+    BYTE tail[65536 + 22], local[30], *dir = NULL, *p, *end;
+    UINT64 size, dir_offset = 0, dir_size = 0, data_offset = 0, csize = 0, usize = 0;
+    LARGE_INTEGER file_size;
+    DWORD tail_len, i;
+    char *out = NULL, *raw = NULL;
+    UINT16 method = 0;
+    BOOL found = FALSE;
+
+    if (!GetFileSizeEx( file, &file_size )) return NULL;
+    size = file_size.QuadPart;
+    tail_len = size < sizeof(tail) ? size : sizeof(tail);
+    if (tail_len < 22 || !read_at( file, size - tail_len, tail, tail_len )) return NULL;
+    for (i = tail_len - 22; ; i--)
+    {
+        if (u32( tail + i ) == 0x06054b50)
+        {
+            dir_size = u32( tail + i + 12 );
+            dir_offset = u32( tail + i + 16 );
+            /* zip64: the locator right before the end record points at the zip64 end record */
+            if (i >= 20 && u32( tail + i - 20 ) == 0x07064b50)
+            {
+                BYTE end64[56];
+                if (read_at( file, u64( tail + i - 12 ), end64, sizeof(end64) ) && u32( end64 ) == 0x06064b50)
+                {
+                    dir_size = u64( end64 + 40 );
+                    dir_offset = u64( end64 + 48 );
+                }
+            }
+            break;
+        }
+        if (!i) return NULL;
+    }
+    if (!dir_size || dir_size > 64 << 20 || dir_offset + dir_size > size || !(dir = malloc( dir_size ))) return NULL;
+    if (!read_at( file, dir_offset, dir, dir_size )) goto done;
+
+    for (p = dir, end = dir + dir_size; p + 46 <= end && u32( p ) == 0x02014b50; )
+    {
+        UINT16 name_len = u16( p + 28 ), extra_len = u16( p + 30 ), comment_len = u16( p + 32 );
+        if (p + 46 + name_len + extra_len > end) break;
+        if (name_len == strlen( wanted ) && !_strnicmp( (char *)p + 46, wanted, name_len ))
+        {
+            const BYTE *x = p + 46 + name_len, *xend = x + extra_len;
+            method = u16( p + 10 );
+            csize = u32( p + 20 );
+            usize = u32( p + 24 );
+            data_offset = u32( p + 42 );
+            for (; x + 4 <= xend; x += 4 + u16( x + 2 ))
+            {
+                const BYTE *v = x + 4, *vend = v + u16( x + 2 );
+                if (u16( x ) != 1 || vend > xend) continue;
+                /* zip64 extra field: the 64-bit values of the fields that were 0xffffffff, in this order */
+                if (usize == 0xffffffff && v + 8 <= vend) { usize = u64( v ); v += 8; }
+                if (csize == 0xffffffff && v + 8 <= vend) { csize = u64( v ); v += 8; }
+                if (data_offset == 0xffffffff && v + 8 <= vend) data_offset = u64( v );
+            }
+            found = TRUE;
+            break;
+        }
+        p += 46 + name_len + extra_len + comment_len;
+    }
+    if (!found || usize > 16 << 20 || csize > 16 << 20 || (method != 0 && method != 8)) goto done;
+    if (!read_at( file, data_offset, local, sizeof(local) ) || u32( local ) != 0x04034b50) goto done;
+    data_offset += 30 + u16( local + 26 ) + u16( local + 28 );
+    if (!(raw = malloc( csize + 1 )) || !(out = malloc( usize + 1 ))) goto fail;
+    if (!read_at( file, data_offset, raw, csize )) goto fail;
+    if (method == 0)
+    {
+        if (csize != usize) goto fail;
+        memcpy( out, raw, usize );
+    }
+    else
+    {
+        z_stream z = { 0 };
+        int ret;
+
+        z.zalloc = zalloc;
+        z.zfree = zfree;
+        z.next_in = (BYTE *)raw;
+        z.avail_in = csize;
+        z.next_out = (BYTE *)out;
+        z.avail_out = usize;
+        if (inflateInit2( &z, -15 ) != Z_OK) goto fail;
+        ret = inflate( &z, Z_FINISH );
+        inflateEnd( &z );
+        if (ret != Z_STREAM_END || z.total_out != usize) goto fail;
+    }
+    out[usize] = 0;
+    goto done;
+
+fail:
+    free( out );
+    out = NULL;
+done:
+    free( raw );
+    free( dir );
+    return out;
+}
+
+/* an attribute of the first <Identity> element */
+static BOOL identity_attr( const char *xml, const char *attr, WCHAR *buf, DWORD len )
+{
+    const char *id = strstr( xml, "<Identity" ), *close, *p;
+    size_t n = strlen( attr );
+
+    if (!id || !(close = strchr( id, '>' ))) return FALSE;
+    for (p = id; (p = strstr( p, attr )) && p < close; p += n)
+    {
+        const char *v, *e;
+        if (!isspace( (unsigned char)p[-1] ) || p[n] != '=' || (p[n + 1] != '"' && p[n + 1] != '\'')) continue;
+        v = p + n + 2;
+        if (!(e = strchr( v, p[n + 1] )) || e > close) return FALSE;
+        if (!MultiByteToWideChar( CP_UTF8, 0, v, e - v, buf, len - 1 )) return FALSE;
+        buf[min( (DWORD)(e - v), len - 1 )] = 0;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* the package file a file: URI names */
+static HANDLE open_uri( IUriRuntimeClass *uri )
+{
+    WCHAR path[MAX_PATH], *w;
+    const WCHAR *s;
+    HSTRING str = NULL;
+    HANDLE file = INVALID_HANDLE_VALUE;
+    DWORD len = ARRAY_SIZE(path);
+
+    if (FAILED(IUriRuntimeClass_get_AbsoluteUri( uri, &str ))) return file;
+    s = WindowsGetStringRawBuffer( str, NULL );
+    if (!wcsnicmp( s, L"file:", 5 ) && SUCCEEDED(PathCreateFromUrlW( s, path, &len, 0 )))
+    {
+        for (w = path; *w; w++) if (*w == '/') *w = '\\';
+        file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    }
+    WindowsDeleteString( str );
+    return file;
+}
+
+static void parse_version( const WCHAR *s, UINT64 *v )
+{
+    unsigned int p[4] = { 0 };
+    swscanf( s, L"%u.%u.%u.%u", &p[0], &p[1], &p[2], &p[3] );
+    *v = (UINT64)p[0] << 48 | (UINT64)(p[1] & 0xffff) << 32 | (UINT64)(p[2] & 0xffff) << 16 | (p[3] & 0xffff);
+}
+
+static const WCHAR *arch_name( DWORD arch )
+{
+    switch (arch)
+    {
+    case 0: return L"x86";
+    case 5: return L"arm";
+    case 11: return L"neutral";
+    case 12: return L"arm64";
+    default: return L"x64";
+    }
+}
+
+/* S_OK: the package is a stand-in, now at least at its version; S_FALSE: it is not one */
+static HRESULT standin_deploy( IUriRuntimeClass *uri )
+{
+    WCHAR name[128], version[64], sub[256], have_name[128], have_version[64], pid[32], full[512];
+    HANDLE file;
+    char *xml;
+    HKEY root, key;
+    DWORD i, len, arch;
+    UINT64 want, have;
+    HRESULT hr = S_FALSE;
+
+    if (!uri || (file = open_uri( uri )) == INVALID_HANDLE_VALUE)
+    {
+        TRACE( "not a package file this can open\n" );
+        return S_FALSE;
+    }
+    if (!(xml = zip_member( file, "AppxMetadata/AppxBundleManifest.xml" ))) xml = zip_member( file, "AppxManifest.xml" );
+    CloseHandle( file );
+    if (!xml)
+    {
+        WARN( "no manifest found in the package\n" );
+        return S_FALSE;
+    }
+    if (!identity_attr( xml, "Name", name, ARRAY_SIZE(name) ) ||
+        !identity_attr( xml, "Version", version, ARRAY_SIZE(version) ))
+    {
+        free( xml );
+        return S_FALSE;
+    }
+    free( xml );
+    TRACE( "package %s %s\n", debugstr_w(name), debugstr_w(version) );
+
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, STANDIN_KEY, 0, KEY_READ, &root )) return S_FALSE;
+    for (i = 0; len = ARRAY_SIZE(sub), !RegEnumKeyExW( root, i, sub, &len, NULL, NULL, NULL, NULL ); i++)
+    {
+        if (RegOpenKeyExW( root, sub, 0, KEY_READ | KEY_SET_VALUE, &key )) continue;
+        len = sizeof(have_name);
+        if (RegGetValueW( key, NULL, L"Name", RRF_RT_REG_SZ, NULL, have_name, &len ) || wcsicmp( have_name, name ))
+        {
+            RegCloseKey( key );
+            continue;
+        }
+        len = sizeof(have_version);
+        if (RegGetValueW( key, NULL, L"Version", RRF_RT_REG_SZ, NULL, have_version, &len )) have_version[0] = 0;
+        parse_version( version, &want );
+        parse_version( have_version, &have );
+        if (want > have)
+        {
+            len = sizeof(pid);
+            if (RegGetValueW( key, NULL, L"PublisherId", RRF_RT_REG_SZ, NULL, pid, &len )) pid[0] = 0;
+            len = sizeof(arch);
+            if (RegGetValueW( key, NULL, L"Architecture", RRF_RT_REG_DWORD, NULL, &arch, &len )) arch = 9;
+            swprintf( full, ARRAY_SIZE(full), L"%s_%s_%s__%s", have_name, version, arch_name( arch ), pid );
+            RegSetValueExW( key, L"Version", 0, REG_SZ, (BYTE *)version, (wcslen( version ) + 1) * sizeof(WCHAR) );
+            RegSetValueExW( key, L"FullName", 0, REG_SZ, (BYTE *)full, (wcslen( full ) + 1) * sizeof(WCHAR) );
+            FIXME( "stand-in %s: %s -> %s; its client API is wine-uwp's, nothing else is installed\n",
