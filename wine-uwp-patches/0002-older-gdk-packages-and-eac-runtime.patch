+static void set_dll_path(void)
+{
+    /* Proton's anti-cheat runtimes (Steam's "Proton EasyAntiCheat Runtime" and "Proton BattlEye Runtime"): their
+     * builtin bridges stand in for the game's own anti-cheat DLL, as Proton does */
+    static const char *runtime_dirs[][3] =
+    {
+        { "PROTON_EAC_RUNTIME", "/v2/lib32/", "/v2/lib64/" },
+        { "PROTON_BATTLEYE_RUNTIME", "/v1/lib/wine/", "/v1/lib64/wine/" },
+    };
+    char *p, *path = getenv( "WINEDLLPATH" );
+    int i, j, count = 0;
+
+    if (path) for (p = path, count = 1; *p; p++) if (*p == ':') count++;
+
+    dll_paths = malloc( (count + 2 + 2 * ARRAY_SIZE(runtime_dirs)) * sizeof(*dll_paths) );
+    count = 0;
+
+    if (!build_dir) dll_paths[count++] = dll_dir;
+
+    if (path)
+    {
+        path = strdup(path);
+        for (p = strtok( path, ":" ); p; p = strtok( NULL, ":" )) dll_paths[count++] = strdup( p );
+        free( path );
+    }
+
+    for (i = 0; i < ARRAY_SIZE(runtime_dirs); i++)
+    {
+        const char *root = getenv( runtime_dirs[i][0] );
+        if (!root || !*root) continue;
+        for (j = 1; j < 3; j++)
+        {
+            if (!(p = malloc( strlen( root ) + strlen( runtime_dirs[i][j] ) + 1 ))) continue;
+            strcpy( p, root );
+            strcat( p, runtime_dirs[i][j] );
+            dll_paths[count++] = p;
+        }
+    }
+
+    for (i = 0; i < count; i++) dll_path_maxlen = max( dll_path_maxlen, strlen(dll_paths[i]) );
+    dll_paths[count] = NULL;
+}
+
+
+static void set_system_dll_path(void)
+{
+    const char *p, *path = SYSTEMDLLPATH;
+    int count = 0;
+
+    if (path && *path) for (p = path, count = 1; *p; p++) if (*p == ':') count++;
+
+    system_dll_paths = malloc( (count + 1) * sizeof(*system_dll_paths) );
+    count = 0;
+
+    if (path && *path)
+    {
+        char *path_copy = strdup(path);
+        for (p = strtok( path_copy, ":" ); p; p = strtok( NULL, ":" ))
+            system_dll_paths[count++] = strdup( p );
+        free( path_copy );
+    }
+    system_dll_paths[count] = NULL;
+}
