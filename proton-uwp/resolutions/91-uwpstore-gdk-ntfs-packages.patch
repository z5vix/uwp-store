+static HRESULT add_member( struct xvd *xvd, const WCHAR *name, UINT64 size, UINT32 region, struct xvd_member **out )
+{
+    struct xvd_member *members, *m;
+
+    if (unsafe_segment( name ))
+    {
+        ERR( "refusing unsafe path in package: %s\n", debugstr_w(name) );
+        return HRESULT_FROM_WIN32( ERROR_BAD_PATHNAME );
+    }
+    if (!(members = realloc( xvd->members, (xvd->member_count + 1) * sizeof(*members) ))) return E_OUTOFMEMORY;
+    xvd->members = members;
+    m = &members[xvd->member_count];
+    memset( m, 0, sizeof(*m) );
+    if (!(m->name = strdupW( name ))) return E_OUTOFMEMORY;
+    xvd->member_count++;
+    m->size = size;
+    m->region = region;
+    *out = m;
+    return S_OK;
+}
+
+static const struct xvd_region *region_at( const struct xvd *xvd, UINT64 page )
+{
+    unsigned int i;
+    for (i = 0; i < xvd->region_count; i++)
+        if (page >= xvd->regions[i].first_page && page - xvd->regions[i].first_page < xvd->regions[i].pages)
+            return &xvd->regions[i];
+    return NULL;
+}
+
+/* file pages, each decrypted as the region it is in needs (a page in no region is plain) */
+static HRESULT read_any( struct xvd *xvd, UINT64 page, ULONG count, BYTE *out )
+{
+    static const struct xvd_region plain = { 0, 0, 0xffff };
+    HRESULT hr;
+
+    while (count)
+    {
+        const struct xvd_region *r = region_at( xvd, page );
+        ULONG n = count;
+
+        if (r) n = (ULONG)min( (UINT64)n, r->first_page + r->pages - page );
+        else
+        {
+            unsigned int i;
+            for (i = 0; i < xvd->region_count; i++)
+                if (xvd->regions[i].first_page > page)
+                    n = (ULONG)min( (UINT64)n, xvd->regions[i].first_page - page );
+        }
+        if (FAILED(hr = read_pages( xvd, r ? r : &plain, page, n, out ))) return hr;
+        page += n;
+        count -= n;
+        out += (size_t)n * PAGE;
+    }
+    return S_OK;
+}
+
+/*
+ * Older packages: the drive is a disk image (GPT, MBR or none) holding one NTFS volume. Its MFT is read through the
+ * same page decryption, every regular file outside the volume's own $ files becomes a member, and a member's runs are
+ * its clusters' pages. Files the package builder writes are not compressed and have no attribute list.
+ */
+struct ntfs_file
+{
+    WCHAR *name;
+    UINT64 parent, size;
+    BOOL in_use, dir;
+    struct xvd_run *runs;
+    unsigned int run_count;
+    BYTE *resident;
+};
+
+static HRESULT ntfs_runs( struct xvd *xvd, const BYTE *a, ULONG alen, UINT64 base, UINT64 cpp, struct ntfs_file *f )
+{
+    ULONG off = le16( a + 0x20 );
+    INT64 lcn = 0;
+
+    while (off < alen && a[off])
+    {
+        unsigned int ln = a[off] & 15, lo = a[off] >> 4, j;
+        UINT64 length = 0;
+        INT64 delta = 0;
+        struct xvd_run *runs;
+
+        if (!ln || ln > 8 || lo > 8 || off + 1 + ln + lo > alen) return HRESULT_FROM_WIN32( ERROR_BAD_FORMAT );
+        for (j = 0; j < ln; j++) length |= (UINT64)a[off + 1 + j] << (8 * j);
+        for (j = 0; j < lo; j++) delta |= (INT64)a[off + 1 + ln + j] << (8 * j);
+        if (lo && lo < 8 && (a[off + ln + lo] & 0x80)) delta |= -((INT64)1 << (8 * lo));      /* sign-extend */
+        if (!(runs = realloc( f->runs, (f->run_count + 1) * sizeof(*runs) ))) return E_OUTOFMEMORY;
+        f->runs = runs;
+        runs[f->run_count].count = length * cpp;
+        if (lo)
+        {
+            lcn += delta;
+            if (lcn < 0 || base + (UINT64)lcn * cpp + length * cpp > xvd->drive_pages)
+                return HRESULT_FROM_WIN32( ERROR_BAD_FORMAT );
+            runs[f->run_count].page = xvd->drive + base + lcn * cpp;
+        }
+        else runs[f->run_count].page = SPARSE;
+        f->run_count++;
+        off += 1 + ln + lo;
+    }
+    return S_OK;
+}
+
+/* one MFT record: undo its fixups and read its name, parent, size and data */
+static HRESULT ntfs_record( struct xvd *xvd, BYTE *r, ULONG size, UINT64 base, UINT64 cpp, struct ntfs_file *f )
+{
+    UINT16 uo = le16( r + 4 ), un = le16( r + 6 ), flags;
+    ULONG stride, off, i;
+    int name_ns = -1;
+    HRESULT hr;
+
+    if (memcmp( r, "FILE", 4 )) return S_OK;
+    if (un < 2 || uo + 2u * un > size || size % (un - 1)) return HRESULT_FROM_WIN32( ERROR_BAD_FORMAT );
+    stride = size / (un - 1);
+    for (i = 1; i < un; i++)
+    {
+        BYTE *end = r + i * stride - 2;
+        if (memcmp( end, r + uo, 2 )) return HRESULT_FROM_WIN32( ERROR_BAD_FORMAT );
+        memcpy( end, r + uo + 2 * i, 2 );
+    }
+    flags = le16( r + 0x16 );
+    if (!(flags & 1) || (le64( r + 0x20 ) & 0xffffffffffffull)) return S_OK;      /* free, or an extension record */
+    f->in_use = TRUE;
+    f->dir = !!(flags & 2);
+    for (off = le16( r + 0x14 ); off + 16 <= size && le32( r + off ) != 0xffffffff; )
+    {
+        UINT32 type = le32( r + off ), alen = le32( r + off + 4 );
+        const BYTE *a = r + off;
+
+        if (alen < 16 || off + alen > size) return HRESULT_FROM_WIN32( ERROR_BAD_FORMAT );
+        if (type == 0x20)
+        {
+            ERR( "an NTFS file in this package has an attribute list; that is not supported\n" );
+            return HRESULT_FROM_WIN32( ERROR_NOT_SUPPORTED );
+        }
+        if (type == 0x30 && !a[8])
+        {
+            ULONG vo = le16( a + 0x14 ), vl = le32( a + 0x10 );
+            const BYTE *v = a + vo;
+            if (vo + vl > alen || vl < 0x42 || 0x42 + 2u * v[0x40] > vl) return HRESULT_FROM_WIN32( ERROR_BAD_FORMAT );
+            if (v[0x41] != 2 || name_ns < 0)            /* the long name, not the 8.3 one */
+            {
+                free( f->name );
+                if (!(f->name = malloc( (v[0x40] + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+                memcpy( f->name, v + 0x42, v[0x40] * sizeof(WCHAR) );
+                f->name[v[0x40]] = 0;
+                f->parent = le64( v ) & 0xffffffffffffull;
+                name_ns = v[0x41];
+            }
+        }
+        if (type == 0x80 && !a[9])                      /* the unnamed data stream */
+        {
+            if (le16( a + 0x0c ))
+            {
+                ERR( "an NTFS file in this package is compressed, sparse or encrypted; that is not supported\n" );
+                return HRESULT_FROM_WIN32( ERROR_NOT_SUPPORTED );
+            }
+            if (a[8])
+            {
+                if (alen < 0x40 || le64( a + 0x10 )) return HRESULT_FROM_WIN32( ERROR_BAD_FORMAT );
+                f->size = le64( a + 0x30 );
+                if (FAILED(hr = ntfs_runs( xvd, a, alen, base, cpp, f ))) return hr;
+            }
+            else
+            {
+                ULONG vo = le16( a + 0x14 ), vl = le32( a + 0x10 );
+                if (vo + vl > alen) return HRESULT_FROM_WIN32( ERROR_BAD_FORMAT );
+                f->size = vl;
+                if (!(f->resident = malloc( vl ? vl : 1 ))) return E_OUTOFMEMORY;
+                memcpy( f->resident, a + vo, vl );
+            }
+        }
+        off += alen;
+    }
+    return S_OK;
+}
+
+/* where the NTFS volume starts, in drive pages */
+static HRESULT ntfs_volume( struct xvd *xvd, UINT64 *base, BYTE *boot )
+{
+    BYTE *buf;
+    HRESULT hr;
+    UINT64 lba = 0;
+
+    if (!(buf = malloc( 2 * PAGE ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = read_any( xvd, xvd->drive, 2, buf ))) goto done;
+    *base = 0;
+    if (!memcmp( buf + 3, "NTFS    ", 8 )) goto found;
+    if (!memcmp( buf + PAGE, "EFI PART", 8 ))           /* 4096-byte sectors: the GPT header is the second page */
+    {
+        UINT64 entries = le64( buf + PAGE + 72 );
+        UINT32 n = le32( buf + PAGE + 80 ), size = le32( buf + PAGE + 84 ), i;
+        hr = HRESULT_FROM_WIN32( ERROR_BAD_FORMAT );
+        if (size < 128 || size > PAGE || entries >= xvd->drive_pages) goto done;
+        if (FAILED(hr = read_any( xvd, xvd->drive + entries, 1, buf ))) goto done;
+        for (i = 0; i < n && (i + 1) * size <= PAGE; i++)
+        {
+            const BYTE *e = buf + i * size;
+            static const BYTE zero[16];
+            if (memcmp( e, zero, 16 )) { lba = le64( e + 32 ); break; }
+        }
+    }
+    else if (buf[0x1fe] == 0x55 && buf[0x1ff] == 0xaa && buf[0x1c2] && buf[0x1c2] != 0xee)
+        lba = le32( buf + 0x1c6 ) * 512ull / PAGE;
+    hr = HRESULT_FROM_WIN32( ERROR_BAD_FORMAT );
+    if (!lba || lba >= xvd->drive_pages) goto done;
+    *base = lba;
+    if (FAILED(hr = read_any( xvd, xvd->drive + lba, 1, buf ))) goto done;
+    hr = HRESULT_FROM_WIN32( ERROR_BAD_FORMAT );
+    if (memcmp( buf + 3, "NTFS    ", 8 )) goto done;
+found:
+    memcpy( boot, buf, 512 );
+    hr = S_OK;
+done:
+    free( buf );
+    return hr;
+}
+
+static HRESULT ntfs_members( struct xvd *xvd, const struct appx_install_params *params )
+{
+    struct ntfs_file *files = NULL, mft = { 0 };
+    UINT64 base, cluster, cpp, record_size, count = 0, i, at = 0;
+    BYTE boot[512], *buf = NULL;
+    unsigned int k;
+    signed char rs;
+    HRESULT hr;
+
+    if (FAILED(hr = ntfs_volume( xvd, &base, boot )))
+    {
+        ERR( "this GDK package has no segment table and no NTFS volume; it is not supported\n" );
+        return hr;
+    }
+    hr = HRESULT_FROM_WIN32( ERROR_BAD_FORMAT );
+    cluster = (UINT64)le16( boot + 0x0b ) * boot[0x0d];
+    rs = (signed char)boot[0x40];
+    record_size = rs < 0 ? 1ull << -rs : rs * cluster;
+    if (!cluster || cluster % PAGE || record_size < 512 || PAGE % record_size)
+    {
+        ERR( "NTFS clusters of %I64u bytes and records of %I64u are not supported\n", cluster, record_size );
+        return HRESULT_FROM_WIN32( ERROR_NOT_SUPPORTED );
+    }
+    cpp = cluster / PAGE;
+    TRACE( "NTFS volume at drive page %I64u, %I64u-byte clusters, MFT at %I64u\n", base, cluster, le64( boot + 0x30 ) );
+
+    /* record 0 is the MFT itself */
+    if (!(buf = malloc( PAGES_PER_READ * PAGE ))) return E_OUTOFMEMORY;
+    if (le64( boot + 0x30 ) * cpp + base >= xvd->drive_pages) goto done;
+    if (FAILED(hr = read_any( xvd, xvd->drive + base + le64( boot + 0x30 ) * cpp, 1, buf ))) goto done;
+    if (FAILED(hr = ntfs_record( xvd, buf, record_size, base, cpp, &mft ))) goto done;
+    hr = HRESULT_FROM_WIN32( ERROR_BAD_FORMAT );
+    if (!mft.run_count || mft.size > (1ull << 32)) goto done;
+    count = mft.size / record_size;
+    if (!(files = calloc( count ? count : 1, sizeof(*files) ))) { hr = E_OUTOFMEMORY; goto done; }
+    for (k = 0; k < mft.run_count && at < count; k++)
+    {
+        UINT64 page = mft.runs[k].page, left = mft.runs[k].count;
+        while (left && at < count)
+        {
+            ULONG n = (ULONG)min( left, PAGES_PER_READ ), j;
+            if (page == SPARSE) goto done;
+            if (FAILED(hr = read_any( xvd, page, n, buf ))) goto done;
+            for (j = 0; j < n * (PAGE / record_size) && at < count; j++, at++)
+                if (FAILED(hr = ntfs_record( xvd, buf + j * record_size, record_size, base, cpp, &files[at] )))
+                    goto done;
+            page += n;
+            left -= n;
+        }
+    }
+
+    /* the files, with their paths from the root (record 5) */
+    for (i = 16; i < count; i++)
+    {
+        struct ntfs_file *f = &files[i];
+        UINT64 chain[64], p = i;
+        unsigned int depth = 0, len = 0, d;
+        const struct xvd_region *r = NULL;
+        struct xvd_member *m;
+        WCHAR *path;
+
+        if (!f->in_use || f->dir || !f->name) continue;
+        while (p != 5 && depth < ARRAY_SIZE(chain) && p < count && files[p].in_use && files[p].name)
+        {
+            chain[depth++] = p;
+            len += wcslen( files[p].name ) + 1;
+            p = files[p].parent;
+        }
+        if (p != 5) continue;                           /* orphaned, or a loop */
+        if (files[chain[depth - 1]].name[0] == '$') continue;     /* the volume's own files ($Extend) */
+        if (!(path = malloc( len * sizeof(WCHAR) ))) { hr = E_OUTOFMEMORY; goto done; }
+        path[0] = 0;
+        for (d = depth; d--; )
+        {
+            wcscat( path, files[chain[d]].name );
+            if (d) wcscat( path, L"/" );
+        }
+        for (k = 0; k < f->run_count && !r; k++) if (f->runs[k].page != SPARSE) r = region_at( xvd, f->runs[k].page );
+        if (r && !region_wanted( r, params ))
+        {
+            free( path );
+            continue;
+        }
+        hr = add_member( xvd, path, f->size, r ? r->id : 0x40000002, &m );
+        free( path );
+        if (FAILED(hr)) goto done;
+        m->runs = f->runs;
+        m->run_count = f->run_count;
+        m->resident = f->resident;
+        f->runs = NULL;
+        f->resident = NULL;
+    }
+    hr = S_OK;
+
+done:
+    for (i = 0; i < count; i++)
+    {
+        free( files[i].name );
+        free( files[i].runs );
+        free( files[i].resident );
+    }
+    free( files );
+    free( mft.name );
+    free( mft.runs );
+    free( mft.resident );
+    free( buf );
+    return hr;
+}
