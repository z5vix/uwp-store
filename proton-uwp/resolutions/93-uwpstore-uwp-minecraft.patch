+    v[4] = empty_GetRuntimeClassName; v[5] = object_GetTrustLevel;
+    v[6] = empty_iterable_First;
+
+    v = empty_iterator_vtbl;
+    v[0] = empty_iterator_QueryInterface; v[1] = object_AddRef; v[2] = object_Release; v[3] = object_GetIids;
+    v[4] = empty_GetRuntimeClassName; v[5] = object_GetTrustLevel;
+    v[6] = empty_iterator_get_Current; v[7] = empty_iterator_false; /* HasCurrent */
+    v[8] = empty_iterator_false; /* MoveNext */ v[9] = empty_iterator_GetMany;
+
+    v = query_vtbl;
+    v[0] = query_QueryInterface; v[1] = object_AddRef; v[2] = object_Release; v[3] = object_GetIids;
+    v[4] = query_GetRuntimeClassName; v[5] = object_GetTrustLevel;
+    v[6] = query_get_Products; v[7] = query_get_ExtendedError;
